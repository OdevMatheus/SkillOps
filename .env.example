# ============================================================================
# SkillOps — AI Frameworks, TDD Evaluation & MCP Environment Configuration
# Copy this file to `.env` for local live evaluation runs (`skillops eval --mode live`).
# Deterministic CI audits and evaluations (`--mode deterministic`) require ZERO API keys.
# ============================================================================

# --- AI Provider Credentials (Only required for `--mode live` via OpenAI Agents SDK) ---
OPENAI_API_KEY=

# --- SkillOps TDD Evaluation Engine (`skillops eval`) ---
SKILLOPS_EVAL_MODE=deterministic
SKILLOPS_EVAL_MODEL=gpt-4.1-mini
SKILLOPS_EVAL_TRIALS=3
SKILLOPS_EVAL_MIN_PASS_DELTA=0.15

# --- Semantic Collision & Token Budget Auditor (`skillops audit`) ---
SKILLOPS_COLLISION_WARN_THRESHOLD=0.78
SKILLOPS_COLLISION_ERROR_THRESHOLD=0.85
SKILLOPS_MAX_L1_TOKENS=90
SKILLOPS_MAX_L2_LINES=250
SKILLOPS_MAX_BUNDLE_SKILLS=12

# --- FastMCP Server & Local FastAPI Benchmark Viewer (`skillops mcp` / `skillops serve`) ---
# Strictly bound to localhost (127.0.0.1) for security isolation
SKILLOPS_MCP_TRANSPORT=stdio
SKILLOPS_SERVER_HOST=127.0.0.1
SKILLOPS_SERVER_PORT=8080
