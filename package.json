{
	"name": "skillops-cli",
	"version": "1.5.1",
	"description": "Install and manage AI coding Skills (SKILL.md) and Subagents (SUBAGENT.md) across 28 AI IDEs and CLIs (Cursor, Claude Code, Copilot, Antigravity, Windsurf, Codex, Gemini CLI & more).",
	"type": "module",
	"license": "MIT",
	"author": "OdevMatheus <matheusvita007@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/skillops-toolkit/SkillOps.git"
	},
	"homepage": "https://github.com/skillops-toolkit/SkillOps#readme",
	"bugs": {
		"url": "https://github.com/skillops-toolkit/SkillOps/issues"
	},
	"bin": {
		"skillops-cli": "./dist/cli.js",
		"skillops": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"catalog",
		".github/agents",
		"SKILL_CONTRACT.md",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "npm run build && npm test",
		"lint": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"skillops": "node dist/cli.js"
	},
	"dependencies": {
		"yaml": "^2.7.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsup": "^9.0.0",
		"typescript": "^5.8.2",
		"vitest": "^5.1.0"
	},
	"keywords": [
		"ai-agents",
		"agent-skills",
		"subagents",
		"token-economy",
		"claude-code",
		"cursor",
		"antigravity",
		"codex",
		"github-copilot",
		"windsurf",
		"cline",
		"roocode",
		"kilocode",
		"zed",
		"continue",
		"aider",
		"openhands",
		"amp",
		"goose",
		"opencode",
		"kiro",
		"trae",
		"amazon-q",
		"junie",
		"gemini-cli",
		"factory-ai",
		"qwen-code",
		"augment-code",
		"mistral-vibe",
		"warp",
		"charm-crush",
		"firebase-studio",
		"mcp",
		"context-engineering"
	]
}
