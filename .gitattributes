# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Documentation & AI Agent Contracts
*.md text eol=lf
*.mdc text eol=lf
*.txt text eol=lf

# TypeScript / Node.js 20+ NPX Engine & Deterministic Python 3.12+ Catalog Scripts
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Shell & Automation Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary & Media Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
