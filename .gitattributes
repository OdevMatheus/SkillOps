# ============================================================================
# SkillOps — Git Attributes & Line Ending Normalization
# Enforces UTF-8 LF line endings across Windows, macOS, and Linux environments.
# ============================================================================

# Default behavior: auto-detect text files and normalize to LF on checkout/commit
* text=auto eol=lf

# AI Agent Instructions & Documentation
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf

# Configuration, Templates & Manifests
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
CODEOWNERS text eol=lf
LICENSE text eol=lf

# Web & Scripting Files (for future Sprints)
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.astro text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary Assets (do not modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
