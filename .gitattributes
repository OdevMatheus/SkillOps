# ============================================================================
# SkillOps — Git Attributes & Line Ending Normalization
# Enforces UTF-8 LF line endings across Windows, macOS, and Linux for
# AI Agent Skills (SKILL.md), Subagents (.agent.md), Cursor Rules (.mdc),
# and Python 3.12+ Core Engine & Deterministic Scripts.
# ============================================================================

# Default behavior: auto-detect text files and normalize to LF on checkout/commit
* text=auto eol=lf

# AI Agent Skills, Subagents, Cursor Rules & Documentation
*.md text eol=lf
*.mdc text eol=lf
*.txt text eol=lf

# Python 3.12+ Engine, Deterministic Skill Scripts & Type Stubs
*.py text eol=lf
*.pyi text eol=lf

# Configuration, Evals, Benchmarks & Manifests
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
CODEOWNERS text eol=lf
LICENSE text eol=lf

# Binary Assets (do not modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
